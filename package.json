{
  "name": "@openui/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "OpenUI mobile design system tokens & React components",
  "main": "./dist/openui.js",
  "module": "./dist/openui.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/openui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "import": "./dist/openui.js"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/openui.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "guardrails": "node scripts/check-guardrails.mjs",
    "check": "npm run typecheck && npm run guardrails && npm run build",
    "check:node": "node scripts/check-node-version.mjs",
    "build": "npm run build:lib && npm run build:types",
    "build:app": "tsc -b && vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "storybook": "npm run check:node && storybook dev -p 6006 --no-open",
    "build-storybook": "npm run check:node && storybook build"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "storybook": "^10.4.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
